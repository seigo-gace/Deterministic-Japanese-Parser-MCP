{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seigo-gace/Deterministic-Japanese-Parser-MCP/schemas/unified_semantic_record.schema.json",
  "title": "Unified Semantic Record",
  "type": "object",
  "required": [
    "record_id", "surfaces", "source", "approval_scopes"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "lemma": {"type": "string"},
    "surface": {"type": "string"},
    "surfaces": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "readings": {"type": "array", "items": {"type": "string"}},
    "part_of_speech": {"type": "array", "items": {"type": "string"}},
    "meaning_candidates": {"type": "array", "items": {"type": "object"}},
    "polarity": {
      "enum": ["positive", "negative", "neutral", "unspecified"]
    },
    "intensity": {
      "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0
    },
    "context_conditions": {"type": "object"},
    "task_candidates": {"type": "array"},
    "external_action_risk": {"type": ["boolean", "null"]},
    "positive_examples": {"type": "array"},
    "negative_examples": {"type": "array"},
    "boundary_examples": {"type": "array"},
    "source": {
      "type": "object",
      "required": ["dataset", "version", "license", "source_id", "source_sha256"],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "approval_scopes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lexical": {"$ref": "#/$defs/status"},
        "semantic": {"$ref": "#/$defs/status"},
        "pragmatic": {"$ref": "#/$defs/status"},
        "task": {"$ref": "#/$defs/status"},
        "external_action": {"$ref": "#/$defs/status"}
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["approved", "needs-evidence", "rejected", "hold", "not-applicable"]
    }
  }
}
