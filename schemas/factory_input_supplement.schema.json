{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seigo-gace.github.io/deterministic-japanese-parser-mcp/factory_input_supplement.schema.json",
  "title": "Build-time factory input supplement",
  "type": "object",
  "additionalProperties": false,
  "required": ["completion_id", "method", "patch", "evidence", "rationale"],
  "properties": {
    "completion_id": {"type": "string", "pattern": "^PREFAC-[0-9a-f]{32}$"},
    "method": {"const": "chatgpt-build-time"},
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "meanings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "dataset": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "license": {"type": "string", "minLength": 1},
            "source_id": {"type": "string", "minLength": 1},
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rationale": {"type": "string", "minLength": 1}
  }
}
